# Deployment identity. Use local, staging, or production.
APP_ENV=local

# Public values. These are embedded in browser bundles at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Maps Platform: enable Address Validation API and Routes API.
# Server-only; apply API restrictions. Never prefix this key with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=

# Wallet checkout is disabled unless explicitly set to test or live.
# Use only Stripe sandbox keys while APP_ENV is local or staging.
PAYMENTS_MODE=disabled

# Production only: approved HTTPS policy URLs. Keep empty until the owner or
# lawyer approves them. Checkout does not calculate or collect tax.
CHECKOUT_POLICIES_JSON=

# Generate separate random values of at least 32 characters. These must differ.
ORDER_ACCESS_SECRET=
PAYMENT_WORKER_SECRET=

# Vercel Cron sends this value as an Authorization Bearer token. It may be
# omitted locally when the development worker uses PAYMENT_WORKER_SECRET.
CRON_SECRET=

# Order confirmation and owner alert delivery (Resend or a compatible adapter).
# In sandbox, every message goes only to ORDER_TEST_EMAIL.
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_ALERT_EMAIL=
ORDER_TEST_EMAIL=
