{
  "name": "suga-spies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:db:concurrency": "node --env-file=.env.local scripts/test-fulfillment-concurrency.mjs",
    "test:db:payments": "node scripts/test-wallet-database.mjs",
    "test:db:order-tracking:migration": "node scripts/test-order-fulfillment-migration.mjs",
    "test:db": "node scripts/test-all-database.mjs",
    "payments:worker": "node --env-file=.env.local scripts/payment-worker.mjs",
    "test:e2e": "APP_ENV=production NEXT_PUBLIC_SITE_URL=https://suga-spies.test npm run build && NEXT_PUBLIC_SITE_URL=https://suga-spies.test playwright test --project=chromium-desktop --project=webkit-mobile",
    "test:e2e:all": "APP_ENV=production NEXT_PUBLIC_SITE_URL=https://suga-spies.test npm run build && NEXT_PUBLIC_SITE_URL=https://suga-spies.test playwright test",
    "test:e2e:firefox": "APP_ENV=production NEXT_PUBLIC_SITE_URL=https://suga-spies.test npm run build && NEXT_PUBLIC_SITE_URL=https://suga-spies.test playwright test --project=firefox-desktop",
    "test:e2e:update": "APP_ENV=production NEXT_PUBLIC_SITE_URL=https://suga-spies.test npm run build && NEXT_PUBLIC_SITE_URL=https://suga-spies.test playwright test --project=chromium-desktop --project=webkit-mobile --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
